# Editor / tooling
.playwright-mcp/
.DS_Store

# The structured RAG index (~6 MB, no paper full-text) is COMMITTED so deploys
# don't have to rebuild it on the memory-limited free tier. Rebuild + commit it
# when the JSON corpus changes: `python -m scripts.build_index`.
# NOTE: a local build that includes downloaded paper PDFs produces a ~102 MB
# index — do NOT commit that one; keep the committed index to the structured build.

# Runtime cache of admin-approved faculty submissions (preserved across index
# rebuilds). Written at runtime like the DB/staged dir — environment-specific,
# never committed, so it can't leak local/test submissions into the repo.
ResearchSense/backend/app/data/submitted_publications.json

# Data belonging to institutions that signed up for their own workspace. Created
# at runtime and private to each deployment, so it is never committed.
ResearchSense/backend/app/data/workspaces/

# Downloaded paper PDFs (1.1 GB) and coverage artifacts
ResearchSense/backend/papers/*.pdf
ResearchSense/backend/.coverage
